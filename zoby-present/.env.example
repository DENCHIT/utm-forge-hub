# Browser-side. These are compiled into the bundle and are meant to be public:
# row-level security is what protects the data, not the secrecy of this key.
#
# On newer Supabase projects the key to use here is the PUBLISHABLE key
# (sb_publishable_...). On older ones it is the anon key. Either goes here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Public origin used to build the audience QR code links.
# Leave unset locally; set it to your live domain in production, or the QR
# codes on stage will point at localhost.
VITE_PUBLIC_APP_URL=

# --------------------------------------------------------------------------
# NEVER put these in this file, the repo, or a hosting panel:
#
#   - the Supabase SECRET / service role key (sb_secret_...). It bypasses every
#     RLS policy. Edge Functions receive it from Supabase at runtime; nothing
#     else ever needs it. If one is exposed, rotate it in the dashboard.
#   - ANTHROPIC_API_KEY. Set it with:
#       supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# --------------------------------------------------------------------------
