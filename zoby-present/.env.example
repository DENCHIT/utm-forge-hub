# Browser-side (safe to expose; RLS enforces access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin used to build the audience QR code links.
# Leave unset to use the browser's current origin.
VITE_PUBLIC_APP_URL=

# --- Server-side only. Set these as Supabase Edge Function secrets, never here. ---
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
