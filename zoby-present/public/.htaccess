# Apache / LiteSpeed config for shared hosting (Hostinger, cPanel, and similar).
# Vite copies everything in public/ into dist/, so this ships with the build.
#
# THE IMPORTANT BIT: this is a single-page app. The server only has index.html —
# there is no /join/ZOBY26 file on disk. Without the rewrite below, every deep
# link 404s: the QR code, the presenter remote, the stage screen. Only the bare
# domain works, which is exactly the "static deploy didn't work well" failure.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite a file or directory that genuinely exists (JS, CSS, images).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it index.html and let the app
  # work out what to show.
  RewriteRule ^ index.html [L]
</IfModule>

# Vite fingerprints filenames (index-CwnauUEx.js), so assets can be cached hard
# and for ever — a new build produces new names.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html is not fingerprinted. Cache it and phones keep loading the old
  # build after you deploy a fix — during a live session, that is fatal.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Correct types, in case the host guesses wrong.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>
